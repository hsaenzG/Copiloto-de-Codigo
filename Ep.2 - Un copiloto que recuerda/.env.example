# AWS region for Amazon Bedrock (project region). This project uses us-east-2.
AWS_REGION=us-east-2

# AWS CLI profile used for credentials (created via `aws login`).
AWS_PROFILE=my-Free-tier

# Bedrock model / inference profile for Amazon Nova Pro.
# Cross-region US inference profile is recommended and works from us-east-2.
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# Optional: GitHub token for the GitHub MCP server (private repos / higher rate limits).
# GITHUB_TOKEN=

# Optional: disable color output (set to 1 to force plain text).
# NO_COLOR=

# --- Episode 2: conversational memory ---------------------------------------

# Storage backend for the conversation history. Only "json" is implemented in
# this episode; "sqlite", "dynamodb" and "redis" are planned extension points
# (implement the MemoryStore protocol and register in memory.buildStore).
MEMORY_BACKEND=json

# Directory where JSON session history (and shared state) is persisted, one
# subfolder per session_id. Defaults to ~/.code_copilot/sessions when unset.
MEMORY_DIR=.code_copilot/sessions

# Pruning strategy for the context window when it exceeds MEMORY_MAX_TOKENS:
#   truncate  -> sliding window, cheapest, drops old context (no model call).
#   summarize -> summarizes old messages with Nova Pro, preserves context
#                (costs one extra model call per prune event).
MEMORY_STRATEGY=truncate

# Approximate token budget that triggers pruning of the history sent to the
# model. Higher keeps more context (more tokens/cost); lower prunes sooner.
MEMORY_MAX_TOKENS=4000

# Minimum number of most-recent messages always kept intact when pruning, so
# the latest exchange is never summarized or dropped.
MEMORY_PRESERVE_RECENT=2

# Optional: default conversation session id when --session-id is not passed.
# Reuse the same id across runs to recover prior history (long-term memory).
# MEMORY_SESSION_ID=default
